PORT=3000

# Cadena de conexión de MongoDB Atlas. Obligatoria: la app no arranca sin ella.
# No la subas al repositorio con credenciales reales.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/absurd?retryWrites=true&w=majority

JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# OAuth opcional. Si GOOGLE_CLIENT_ID está vacío, la estrategia no se registra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Bundle id de iOS (audience del identity token). Obligatorio para Sign in with Apple.
# Varios ids separados por coma. En Expo Go el audience es host.exp.Exponent.
APPLE_CLIENT_ID=com.cardona.rocks.absurd,host.exp.Exponent
# TEAM_ID / KEY_ID / PRIVATE_KEY solo hacen falta para el flujo OAuth web, no para la app nativa.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Carpeta donde se guardan las imágenes subidas desde el panel.
# En Railway: monta un volumen y apunta esto a su ruta (p. ej. /data).
# Sin volumen, cada despliegue borra lo subido.
UPLOADS_DIR=./uploads

# Primer administrador (solo lo usa `npm run seed:admin`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
